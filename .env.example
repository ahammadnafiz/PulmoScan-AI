# Copy to .env and adjust. Never commit the real .env.

APP_NAME=PulmoScan AI
ENV=development
LOG_LEVEL=INFO

# Path to the trained checkpoint the API serves.
MODEL_PATH=artifacts/training/model.pt

# Leave empty to disable API-key auth. Set a value to require the X-API-Key header.
API_KEY=

# Comma-separated CORS origins.
CORS_ORIGINS=http://localhost:3000

# Max upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
